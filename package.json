{
  "name": "grassroots-football-tournament-management-system-cloud",
  "private": true,
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "pg": "^8.16.3"
  },
  "scripts": {
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "node app.js",
    "db:reset": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/reset.sql",
    "db:seed": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/seed.sql",

    "db:rebuild": "npm run db:reset && npm run db:seed"
  }
}
