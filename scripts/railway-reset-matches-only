#!/usr/bin/env bash
set -euo pipefail

# Always run from repo root
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_ROOT"

if [[ -f .env ]]; then
  set -a; source .env; set +a
fi

: "${RAILWAY_DATABASE_URL:?RAILWAY_DATABASE_URL is not set}"

# Guardrails: Railway only
if ! echo "$RAILWAY_DATABASE_URL" | grep -Eq 'rlwy\.net|railway'; then
  echo "Refusing: RAILWAY_DATABASE_URL does not look like Railway."
  exit 1
fi

echo "⚠️  THIS IS DESTRUCTIVE AND CANNOT BE UNDONE"
echo "⚠️  This will DELETE ALL MATCH DATA ONLY:"
echo "    public.matches (fixtures, kickoff times, results, knockouts)"
echo
read -r -p 'Type RESET_MATCHES_ONLY to continue: ' CONFIRM
if [[ "$CONFIRM" != "RESET_MATCHES_ONLY" ]]; then
  echo "Aborted."
  exit 1
fi

export PGSSLMODE=require

psql "$RAILWAY_DATABASE_URL" -v ON_ERROR_STOP=1 <<'SQL'
BEGIN;
SET search_path = public;

TRUNCATE TABLE public.matches
RESTART IDENTITY CASCADE;

COMMIT;
SQL

echo "✅ Matches cleared; tournaments, leagues, teams preserved."
